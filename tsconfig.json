{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    ".atlas-test-dist",
    "node_modules",
    "data",
    "evidence",
    "playwright-report",
    "test-results",
    "coverage"
  ]
}
