# Frontend: optional. Leave empty for the complete guest/local experience.
PUBLIC_API_URL=
PUBLIC_SUPPORT_EMAIL=
ATLAS_SITE=https://jlsp124.github.io
ATLAS_BASE=/atlas
# Server: use HTTPS in production. Set the exact frontend origin (no path).
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
ALLOWED_ORIGIN=https://jlsp124.github.io
COOKIE_SECURE=true
# Use none for cross-site Pages -> API cookies. Modern browsers may block these;
# a frontend + API under the same parent domain is the recommended synced setup.
COOKIE_SAME_SITE=none
TRUST_PROXY=false
# One-time bootstrap. Remove from environment after creating Jovan.
ATLAS_ADMIN_PASSWORD=

