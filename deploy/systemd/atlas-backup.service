[Unit]
Description=Create a consistent atlas SQLite backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=jovan
Group=jovan
SupplementaryGroups=docker
WorkingDirectory=/opt/atlas
Environment=PATH=/home/jovan/.local/share/mise/shims:/home/jovan/.local/share/mise/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/atlas/scripts/server-backup.sh
UMask=0077
NoNewPrivileges=true
