{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run content:check && astro build && pagefind --site dist && tsx scripts/offline.ts",
    "preview": "astro preview --host 127.0.0.1",
    "server": "tsx server/main.ts",
    "admin:bootstrap": "tsx server/bootstrap.ts",
    "backup": "tsx server/backup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/validate-content.ts",
    "atlas:update": "tsx scripts/update-sources.ts",
    "ingest:bleecker": "tsx scripts/ingest-bleecker.ts",
    "ingest:videos": "tsx scripts/ingest-videos.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fontsource-variable/geist": "5.3.0",
    "argon2": "0.45.1",
    "astro": "7.3.5",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "katex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
