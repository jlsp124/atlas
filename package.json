{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.11.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "npm run content:check && astro build && pagefind --site dist && tsx scripts/offline.ts",
    "preview": "astro preview --host 127.0.0.1",
    "server": "tsx server/main.ts",
    "admin:bootstrap": "tsx server/bootstrap.ts",
    "backup": "tsx server/backup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/validate-content.ts",
    "atlas:update": "tsx scripts/update-sources.ts",
    "ingest:bleecker": "tsx scripts/ingest-bleecker.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@fastify/cookie": "latest",
    "@fastify/cors": "latest",
    "@fastify/helmet": "latest",
    "@fastify/rate-limit": "latest",
    "@fontsource-variable/inter": "latest",
    "argon2": "0.45.1",
    "astro": "7.3.5",
    "better-sqlite3": "13.0.3",
    "cytoscape": "3.34.3",
    "fastify": "5.12.5",
    "katex": "0.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "latest",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "latest",
    "@types/cytoscape": "latest",
    "@types/katex": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-jsx-a11y": "latest",
    "globals": "latest",
    "pagefind": "1.5.2",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "5.0.3"
  }
}
