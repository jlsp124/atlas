---
import Shell from '../components/Shell';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/flows.css';
import '../styles/workspace.css';
const {
  title = 'Your atlas',
  description = 'Everything from class, without digging for it.',
  course,
  focus = false,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path = '') => `${base}/${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4947ce" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('icon.svg')} />
    <link rel="apple-touch-icon" href={url('icons/icon-192.png')} />
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta property="og:title" content={`${title} · atlas`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title} · atlas</title>
    <script is:inline>
      if (/\/work\//.test(location.pathname) && location.hash.startsWith('#q-'))
        document.documentElement.dataset.pendingQuestion = 'true';
      try {
        const theme = localStorage.getItem('atlas:theme');
        if (['light', 'dark', 'system'].includes(theme))
          document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class:list={['app-shell', { focused: focus }]}>
      <Shell client:load course={course} focus={focus} />
      <main id="main" tabindex="-1" data-pagefind-body>
        <slot />
      </main>
    </div>
    <div
      class="route-loader"
      role="status"
      aria-live="polite"
      aria-hidden="true"
    >
      <span class="wordmark">
        atlas<span>.</span>
      </span>
      <small>Opening your workspace…</small>
    </div>
    <script>
      const loader = document.querySelector<HTMLElement>('.route-loader');
      loader?.addEventListener('animationstart', () =>
        loader.setAttribute('aria-hidden', 'false'),
      );
      document.addEventListener('click', (event) => {
        const link = (event.target as Element)?.closest('a');
        if (
          !link ||
          event.defaultPrevented ||
          event.button ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          link.target ||
          link.hasAttribute('download')
        )
          return;
        const destination = new URL(link.href, location.href);
        if (
          destination.origin === location.origin &&
          destination.pathname !== location.pathname
        ) {
          loader?.classList.add('loading');
        }
      });
      window.addEventListener('pageshow', () => {
        loader?.classList.remove('loading');
        loader?.setAttribute('aria-hidden', 'true');
      });
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        const path = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`;
        window.addEventListener('load', () => {
          void navigator.serviceWorker
            .register(path)
            .then((reg) => {
              const showUpdate = (worker: ServiceWorker | null) => {
                if (
                  !worker ||
                  !navigator.serviceWorker.controller ||
                  document.querySelector('.update-notice')
                )
                  return;
                const notice = document.createElement('div');
                notice.className = 'update-notice';
                notice.setAttribute('role', 'status');
                notice.append('A fresh atlas is ready. ');
                const button = document.createElement('button');
                button.textContent = 'Update';
                button.onclick = () => {
                  (reg.waiting ?? worker).postMessage({ type: 'SKIP_WAITING' });
                };
                notice.append(button);
                document.body.append(notice);
              };
              const watchInstalling = (worker: ServiceWorker | null) => {
                worker?.addEventListener('statechange', () => {
                  if (worker.state === 'installed')
                    showUpdate(reg.waiting ?? worker);
                });
              };
              showUpdate(reg.waiting);
              watchInstalling(reg.installing);
              reg.addEventListener('updatefound', () => {
                watchInstalling(reg.installing);
              });
            })
            .catch(() => {});
        });
        const hadController = Boolean(navigator.serviceWorker.controller);
        let changed = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (hadController && !changed) {
            changed = true;
            window.location.reload();
          }
        });
      }
    </script>
  </body>
</html>
