---
import Layout from '../../layouts/Layout.astro';
import Topic from '../../components/Lesson';
import { concepts } from '../../content/catalog';
import { topicTitle } from '../../content/workspaces';
export function getStaticPaths() {
  return concepts
    .filter((c) => c.status === 'publishable')
    .map((c) => ({ params: { id: c.id }, props: { concept: c } }));
}
const { concept: c } = Astro.props;
---

<Layout title={topicTitle(c.id)} description={c.model} course={c.course} focus>
  <Topic id={c.id} client:load />
</Layout>
