---
import Layout from '../layouts/Layout.astro';
import { sources, snapshot } from '../content/catalog';
import ingestion from '../content/ingestion/bleecker.json';
import videos from '../content/ingestion/videos.json';
import { supportEmail } from '../content/product';
---

<Layout title="Sources">
  <article class="prose">
    <h1>Where it comes from</h1>
    <p>
      I use our class notes and the teacher’s resources to write the
      explanations and practice here. Restricted worksheets and answer keys stay
      with their original sources.
    </p>
    <p class="meta">Last content update: {snapshot.date}</p>
    <p class="small">
      Something missing or incorrect?{' '}
      <a href={`mailto:${supportEmail}?subject=atlas%20sources`}>
        Contact atlas
      </a>
      .
    </p>
    <div class="source-list">
      {sources.map((s) => (
        <details class="source-row">
          <summary>{s.title}</summary>
          <p>{s.notes}</p>
          <small>
            {s.author} · checked {s.checked} · {s.rights}
          </small>
          {s.url && (
            <p>
              <a href={s.url} target="_blank" rel="noreferrer">
                Open source ↗
              </a>
            </p>
          )}
        </details>
      ))}
    </div>
    <details class="settings-section">
      <summary>Content index details</summary>
      <p>
        Class-note snapshot: {snapshot.vaultCommit}. Private grades, personal
        schedules and restricted scans aren’t published.
      </p>
      <p>
        {ingestion.sources.filter((s) => s.type === 'page').length} public pages
        indexed. A saved link doesn’t mean its text was reproduced or reviewed.
      </p>
      <ul>
        {ingestion.sources.map((s) => (
          <li>
            <a href={s.finalUrl}>{s.id}</a> · HTTP {s.httpStatus}
          </li>
        ))}
      </ul>
      <p>
        Video metadata is checked separately. Captions weren’t available through
        the checked endpoint.
      </p>
      <ul>
        {videos.videos.map((v) => (
          <li>
            <a href={v.url}>{v.title || 'Unavailable video'}</a>
          </li>
        ))}
      </ul>
    </details>
  </article>
</Layout>
