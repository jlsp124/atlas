---
import Layout from '../layouts/Layout.astro';
import { Coordinates } from '../components/Icons';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="About">
  <article class="prose about">
    <Coordinates />
    <h1>About atlas.</h1>
    <p>
      I built atlas because we’re all getting the same pile of notes, worksheets
      and random dates anyway. I’m taking these classes too, so I’ll keep it
      updated as I get new stuff.
    </p>
    <p>
      If something’s wrong or missing, <a href={base + '/help/'}>tell me</a>.
    </p>
    <details>
      <summary>A few details</summary>
      <p>
        atlas is student-made and isn’t affiliated with the school, district or
        teachers. Check important dates with your teacher. Your progress stays
        on this device unless you choose an account.{' '}
        <a href={base + '/privacy/'}>Privacy</a> ·{' '}
        <a href={base + '/sources/'}>Sources</a>
      </p>
    </details>
    <div class="about-footer">
      Designed & built by Jovan ·{' '}
      <a href="https://github.com/jlsp124/atlas">Open source</a>
    </div>
  </article>
</Layout>
